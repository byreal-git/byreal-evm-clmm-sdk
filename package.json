{
  "name": "@byreal-io/byreal-evm-clmm-sdk",
  "version": "0.1.1",
  "description": "Byreal CLMM SDK for EVM (Byreal custom Uniswap V3 style contracts)",
  "type": "module",
  "license": "MIT",
  "author": "Byreal Team (https://github.com/byreal-git)",
  "homepage": "https://github.com/byreal-git/byreal-evm-clmm-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byreal-git/byreal-evm-clmm-sdk.git"
  },
  "keywords": [
    "evm",
    "mantle",
    "clmm",
    "concentrated-liquidity",
    "uniswap-v3",
    "defi",
    "dex",
    "sdk"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js",
      "default": "./dist/compat/index.js"
    },
    "./raw": {
      "types": "./dist/raw/index.d.ts",
      "import": "./dist/raw/index.js",
      "default": "./dist/raw/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check:dist": "node scripts/checkDist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:dist",
    "preversion": "npm run verify",
    "postversion": "npm publish && git push && git push --tags",
    "prepublishOnly": "npm run build && npm run check:dist"
  },
  "dependencies": {
    "@ethersproject/abi": "5.8.0",
    "@ethersproject/address": "5.8.0",
    "@ethersproject/bignumber": "5.8.0",
    "@ethersproject/solidity": "5.8.0",
    "big.js": "5.2.2",
    "decimal.js-light": "2.5.1",
    "jsbi": "3.2.5",
    "tiny-invariant": "1.3.3",
    "tiny-warning": "1.0.3",
    "toformat": "2.0.0"
  },
  "peerDependencies": {
    "viem": "^2.22.0"
  },
  "devDependencies": {
    "@types/big.js": "4.0.5",
    "@types/node": "20.19.26",
    "tsx": "4.21.0",
    "typescript": "5.8.2",
    "viem": "2.55.5",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "$vite"
  }
}
